From 0fc0df8aeaa654b5f5b6e01a44b19cfaec199ed3 Mon Sep 17 00:00:00 2001
From: Cristian Ciocaltea <cristian.ciocaltea@collabora.com>
Date: Fri, 2 Feb 2024 23:45:26 +0200
Subject: [PATCH] gitlab-ci: Enable support for CDC NCM

This allows using networking on the Steam Deck docking station.

Signed-off-by: Cristian Ciocaltea <cristian.ciocaltea@collabora.com>
Signed-off-by: Henry Paradiz <henry.paradiz@gmail.com>
---
 .config-fragment-extra | 1 -
 1 file changed, 1 deletion(-)

diff --git a/.config-fragment-extra b/.config-fragment-extra
index faaa650fed18..8a122a5a4dd1 100644
--- a/.config-fragment-extra
+++ b/.config-fragment-extra
@@ -560,7 +560,6 @@ CONFIG_USB_HID=y
 CONFIG_USB_LED_TRIG=y
 # CONFIG_USB_NET_AX88179_178A is not set
 # CONFIG_USB_NET_AX8817X is not set
-# CONFIG_USB_NET_CDC_NCM is not set
 # CONFIG_USB_NET_CDC_SUBSET is not set
 CONFIG_USB_NET_DRIVERS=y
 # CONFIG_USB_NET_NET1080 is not set
-- 
2.55.0

