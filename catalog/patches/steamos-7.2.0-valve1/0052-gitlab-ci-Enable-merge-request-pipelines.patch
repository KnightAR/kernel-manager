From f83e119b47cbe0f9c9d81f4f8900c244cfb3a3bb Mon Sep 17 00:00:00 2001
From: Cristian Ciocaltea <cristian.ciocaltea@collabora.com>
Date: Thu, 13 Jun 2024 00:09:59 +0300
Subject: [PATCH] gitlab-ci: Enable merge request pipelines

Configure the CI jobs to run in merge request pipelines.

Signed-off-by: Cristian Ciocaltea <cristian.ciocaltea@collabora.com>
Signed-off-by: Henry Paradiz <henry.paradiz@gmail.com>
---
 .gitlab-ci.yml | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/.gitlab-ci.yml b/.gitlab-ci.yml
index dd0b81388d9f..f0b1cc9006c4 100644
--- a/.gitlab-ci.yml
+++ b/.gitlab-ci.yml
@@ -16,6 +16,7 @@ default:
 
 workflow:
   rules:
+    - if: $CI_PIPELINE_SOURCE == 'merge_request_event'
     - if: $CI_COMMIT_TAG
     - if: $CI_COMMIT_BRANCH
   auto_cancel:
@@ -92,7 +93,7 @@ build-kernel-neptune:
   extends:
     - .use-debian-kernel-builder
   rules:
-    - if: $CI_COMMIT_TAG == null && $CI_COMMIT_BRANCH !~ /-integration$/
+    - if: $CI_PIPELINE_SOURCE != 'merge_request_event' && $CI_COMMIT_TAG == null && $CI_COMMIT_BRANCH !~ /-integration$/
       when: manual
       allow_failure: true
     - when: on_success
@@ -154,7 +155,7 @@ test-kernel-qemu:
   needs:
     - build-kernel-qemu
   rules:
-    - if: $CI_COMMIT_TAG == null
+    - if: $CI_PIPELINE_SOURCE != 'merge_request_event' && $CI_COMMIT_TAG == null
       when: manual
       allow_failure: true
     - when: on_success
-- 
