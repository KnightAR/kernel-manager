From ab2e3d975b9706e798fa1f85a4dec0afc33c13b3 Mon Sep 17 00:00:00 2001
From: Cristian Ciocaltea <cristian.ciocaltea@collabora.com>
Date: Mon, 4 Mar 2024 04:00:41 +0200
Subject: [PATCH] gitlab-ci: Do not block pipeline on manual jobs

Set allow_failure flag for manual jobs to unblock pipeline execution.

Signed-off-by: Cristian Ciocaltea <cristian.ciocaltea@collabora.com>
Signed-off-by: Henry Paradiz <henry.paradiz@gmail.com>
---
 .gitlab-ci.yml | 13 ++++++++-----
 1 file changed, 8 insertions(+), 5 deletions(-)

diff --git a/.gitlab-ci.yml b/.gitlab-ci.yml
index 190cb649e3a6..8b969073c29d 100644
--- a/.gitlab-ci.yml
+++ b/.gitlab-ci.yml
@@ -92,9 +92,10 @@ build-kernel-neptune:
   extends:
     - .use-debian-kernel-builder
   rules:
-    - if: $CI_COMMIT_TAG
-    - if: $CI_COMMIT_BRANCH =~ /-integration$/
-    - when: manual
+    - if: $CI_COMMIT_TAG == null && $CI_COMMIT_BRANCH !~ /-integration$/
+      when: manual
+      allow_failure: true
+    - when: on_success
   variables:
     BUILD_DIR: build/neptune
   script:
@@ -152,8 +153,10 @@ test-kernel-qemu:
   needs:
     - build-kernel-qemu
   rules:
-    - if: $CI_COMMIT_TAG
-    - when: manual
+    - if: $CI_COMMIT_TAG == null
+      when: manual
+      allow_failure: true
+    - when: on_success
   script:
     # Download rootfs
     - 'curl -L --header "PRIVATE-TOKEN: ${KERNEL_RESEARCH_ROOTFS_TOKEN}" "${ROOTFS_IMAGE_URL}" --output artifact.zip'
-- 
