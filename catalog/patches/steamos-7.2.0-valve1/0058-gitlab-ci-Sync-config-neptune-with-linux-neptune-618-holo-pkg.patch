From 98291928e8fbc34d45bcc40c93d568a1837bba68 Mon Sep 17 00:00:00 2001
From: Robert Beckett <bob.beckett@collabora.com>
Date: Tue, 28 Jul 2026 13:28:21 +0100
Subject: [PATCH] gitlab-ci: Sync config-neptune with linux-neptune-618 holo
 pkg

Signed-off-by: Robert Beckett <bob.beckett@collabora.com>
Signed-off-by: Henry Paradiz <henry.paradiz@gmail.com>
---
 ci/kernel-config/neptune/config-neptune | 14 ++++++++++++++
 1 file changed, 14 insertions(+)

diff --git a/ci/kernel-config/neptune/config-neptune b/ci/kernel-config/neptune/config-neptune
index ee2648b0d006..2c01a891e095 100644
--- a/ci/kernel-config/neptune/config-neptune
+++ b/ci/kernel-config/neptune/config-neptune
@@ -90,6 +90,12 @@ CONFIG_HID_ASUS_ALLY=m
 CONFIG_ASUS_ARMOURY=m
 CONFIG_ASUS_WMI_DEPRECATED_ATTRS=y
 
+#enable OneXPlayer HID driver
+CONFIG_HID_OXP=m
+
+# enable MSI Claw RGB controller driver
+CONFIG_HID_MSI=m
+
 # PARAVIRT options have overhead, even on bare metal boots. They can cause
 # spinlocks to not be inlined as well. Either way, we don't intend to run this
 # kernel as a guest, so this also clears out a whole bunch of
@@ -134,3 +140,11 @@ CONFIG_DRM_PANIC=n
 
 # Enable Valve LEDs driver
 CONFIG_LEDS_VALVE=m
+
+# Enable realtek dongle for Steam Frame
+CONFIG_RTW89_8852CU=m
+CONFIG_RTW89_8922AU=m
+CONFIG_RTW89_8852AU=m
+CONFIG_RTW89_8852BU=m
+CONFIG_RTW89_8851BU=m
+CONFIG_RTW89_USB=m
-- 
2.55.0

