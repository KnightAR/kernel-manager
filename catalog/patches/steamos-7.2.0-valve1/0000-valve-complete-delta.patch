@@ -0,0 +1,21 @@
+ARG DISTRO_BASE=debian
+ARG DISTRO_TAG=bookworm-slim
+
+FROM $DISTRO_BASE:$DISTRO_TAG
+
+ENV LANG=C.UTF-8
+ENV LC_ALL C.UTF-8
+
+ENV DEBIAN_FRONTEND=noninteractive
+
