From 90a43a68cfe96c33b42a6c1d77a0dd29af24d601 Mon Sep 17 00:00:00 2001
From: Robert Beckett <bob.beckett@collabora.com>
Date: Fri, 9 May 2025 19:30:01 +0100
Subject: [PATCH] [NOT-FOR-UPSTREAM] drm/amd/display: really dumb vrr resume
 fix
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

during dm resume, if the device is connected to a vrr monitor via
display port, the display is black and unusable until a replug of the
display port is done. Otherwise the system is working as normal.

As a temporary fix, re-trigger a dc link detect at the end of resume.
This fixes a 100% failure rate to a 100% success rate.
How or why is unclear as yet.

Don't Upstream: Need to figure out exactly why this works. I tried
various comibinations of integrating the link detect in to the resume
path to no avial. When we get time, we sould be able to figure out a
more integrated upstreamable solution, but for now this works.

Signed-off-by: Robert Beckett <bob.beckett@collabora.com>
Signed-off-by: Nícolas F. R. A. Prado <nfraprado@collabora.com>
Signed-off-by: Henry Paradiz <henry.paradiz@gmail.com>
---
 .../gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c | 43 +++++++++++++++++++
 1 file changed, 43 insertions(+)

diff --git a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c
index 6c745952d186..1e84309618e5 100644
--- a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c
+++ b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c
@@ -3776,6 +3776,48 @@ static void amdgpu_dm_dump_links_and_sinks(struct amdgpu_device *adev)
 	}
 }
 
+static void do_stupid_retrigger(struct drm_device *ddev)
+{
+	struct amdgpu_device *adev = drm_to_adev(ddev);
+	struct amdgpu_dm_connector *aconnector;
+	struct dm_connector_state *dm_con_state;
+	struct drm_connector *connector;
+	struct drm_connector_list_iter iter;
+	int ret;
+
+	drm_connector_list_iter_begin(ddev, &iter);
+	drm_for_each_connector_iter(connector, &iter) {
+		aconnector = to_amdgpu_dm_connector(connector);
+		dm_con_state = connector->state ? to_dm_connector_state(connector->state) : NULL;
+
+		if (connector->connector_type != DRM_MODE_CONNECTOR_DisplayPort ||
+		    !dm_con_state || !dm_con_state->freesync_capable ||
+		    aconnector->mst_root)
+			continue;
+
+		mutex_lock(&aconnector->hpd_lock);
+
+		mutex_lock(&adev->dm.dc_lock);
+		ret = dc_link_detect(aconnector->dc_link, DETECT_REASON_HPD);
+		mutex_unlock(&adev->dm.dc_lock);
+
+		if (!ret) {
+			mutex_unlock(&aconnector->hpd_lock);
+			continue;
+		}
+
+		amdgpu_dm_update_connector_after_detect(aconnector);
+
+		drm_modeset_lock_all(ddev);
+		dm_restore_drm_connector_state(ddev, connector);
+		drm_modeset_unlock_all(ddev);
+
+		drm_kms_helper_connector_hotplug_event(connector);
+
+		mutex_unlock(&aconnector->hpd_lock);
+	}
+}
+
 static int dm_resume(struct amdgpu_ip_block *ip_block)
 {
 	struct amdgpu_device *adev = ip_block->adev;
@@ -3999,6 +4041,7 @@ static int dm_resume(struct amdgpu_ip_block *ip_block)
 
 	drm_kms_helper_hotplug_event(ddev);
 
+	do_stupid_retrigger(ddev);
 	return 0;
 }
 
