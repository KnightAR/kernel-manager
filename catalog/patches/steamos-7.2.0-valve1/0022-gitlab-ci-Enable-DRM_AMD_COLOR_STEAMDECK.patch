From ae025d67817acbe3263130c1e7e840a99cce66dc Mon Sep 17 00:00:00 2001
From: Cristian Ciocaltea <cristian.ciocaltea@collabora.com>
Date: Fri, 2 Jun 2023 09:38:11 +0300
Subject: [PATCH] gitlab-ci: Enable DRM_AMD_COLOR_STEAMDECK

Improve build test coverage by enabling support for AMDGPU color
calibration features.

Signed-off-by: Cristian Ciocaltea <cristian.ciocaltea@collabora.com>
Signed-off-by: Henry Paradiz <henry.paradiz@gmail.com>
---
 .config-fragment-extra | 1 +
 1 file changed, 1 insertion(+)

diff --git a/.config-fragment-extra b/.config-fragment-extra
index 82a6e0191f7e..7b254354fb37 100644
--- a/.config-fragment-extra
+++ b/.config-fragment-extra
@@ -130,6 +130,7 @@ CONFIG_DRM_AMDGPU=y
 CONFIG_DRM_AMDGPU_CIK=y
 CONFIG_DRM_AMDGPU_SI=y
 CONFIG_DRM_AMD_ACP=y
+CONFIG_DRM_AMD_COLOR_STEAMDECK=y
 CONFIG_DRM_AMD_DC_HDCP=y
 CONFIG_DRM_AMD_DC_SI=y
 CONFIG_DRM_DP_AUX_CHARDEV=y
-- 
2.55.0

