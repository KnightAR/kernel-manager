From abbde0d0dae8bec94b425ff6437e4674a78c34d9 Mon Sep 17 00:00:00 2001
From: Cristian Ciocaltea <cristian.ciocaltea@collabora.com>
Date: Wed, 29 May 2024 20:22:36 +0300
Subject: [PATCH] gitlab-ci: Enable ath11k tracing support in QEMU config
 fragment

Signed-off-by: Cristian Ciocaltea <cristian.ciocaltea@collabora.com>
Signed-off-by: Henry Paradiz <henry.paradiz@gmail.com>
---
 ci/kernel-config/qemu/config-fragment | 1 +
 1 file changed, 1 insertion(+)

diff --git a/ci/kernel-config/qemu/config-fragment b/ci/kernel-config/qemu/config-fragment
index 97526220b299..94bfd10aa21e 100644
--- a/ci/kernel-config/qemu/config-fragment
+++ b/ci/kernel-config/qemu/config-fragment
@@ -30,6 +30,7 @@ CONFIG_LTRF216A=y
 
 CONFIG_ATH11K=y
 CONFIG_ATH11K_DEBUGFS=y
+CONFIG_ATH11K_TRACING=y
 CONFIG_ATH11K_PCI=y
 CONFIG_CRYPTO_MICHAEL_MIC=y
 CONFIG_CFG80211_CERTIFICATION_ONUS=y
-- 
2.55.0

