 drivers/gpu/drm/ttm/ttm_resource.c | 118 ++++++++++++++++++++++++++++-
 drivers/gpu/drm/xe/xe_vm.c         |   2 +-
 include/drm/ttm/ttm_bo.h           |  43 ++++++++---
 include/drm/ttm/ttm_resource.h     |  12 ++-
 6 files changed, 255 insertions(+), 24 deletions(-)

