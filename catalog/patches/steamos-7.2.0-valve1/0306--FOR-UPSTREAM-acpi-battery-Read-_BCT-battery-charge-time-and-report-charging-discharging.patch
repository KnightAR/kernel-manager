From e120f27fb23242fd5bd272b8617d7a454222178c Mon Sep 17 00:00:00 2001
From: Umang Jain <uajain@igalia.com>
Date: Wed, 24 Jun 2026 00:34:44 +0530
Subject: [PATCH] [FOR-UPSTREAM] acpi: battery: Read _BCT (battery charge time)
 and report charging/discharging
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

ACPI dump from steamdeck OLED suggests the ACPI reports _BCT (battery
charge time). If the deck is discharging the _BCT reports 0xFFFFFFFF
(charging time unknown). If deck is _really_ charging, _BCT reports
some reasonable value.

Use this to report underpower PSU which report as "Charging" while
discharging the deck.

Test with underpower PSU:
($) cat /sys/class/power_supply/BAT1/status
Discharging

Test with steamdeck PSU:
($) cat /sys/class/power_supply/BAT1/status
Charging

Note : Gamescope still shows "charging" icon so probably userspace is
not reading out : /sys/class/power_supply/BAT1/status.

Signed-off-by: Umang Jain <uajain@igalia.com>

[nfraprado: drop lock like in upstream]
Signed-off-by: Nícolas F. R. A. Prado <nfraprado@collabora.com>
Signed-off-by: Henry Paradiz <henry.paradiz@gmail.com>
---
 drivers/acpi/battery.c | 28 ++++++++++++++++++++++++++++
 1 file changed, 28 insertions(+)

diff --git a/drivers/acpi/battery.c b/drivers/acpi/battery.c
index c3706b1f18dc..9d8d8147bcef 100644
--- a/drivers/acpi/battery.c
+++ b/drivers/acpi/battery.c
@@ -104,6 +104,7 @@ struct acpi_battery {
 	struct notifier_block pm_nb;
 	struct list_head list;
 	unsigned long update_time;
+	unsigned long long charge_time;
 	int revision;
 	int rate_now;
 	int capacity_now;
@@ -230,6 +231,17 @@ static int acpi_battery_get_property(struct power_supply *psy,
 			    battery->rate_now == 0) {
 				/* On charge but no current (0W/0mA). */
 				val->intval = POWER_SUPPLY_STATUS_NOT_CHARGING;
+			} else if (battery->charge_time == ACPI_BATTERY_VALUE_UNKNOWN) {
+				/*
+				 * On steamdeck OLED, lower power PSU can still report
+				 * "Charging" status however, we check here if battery
+				 * charge time is reported as well or not. If not,
+				 * probably we can confirm a lower power PSU which is
+				 * actually discharing the deck.
+				 *
+				 * Hence report status as discharging.
+				 * */
+				val->intval = POWER_SUPPLY_STATUS_DISCHARGING;
 			} else {
 				val->intval = POWER_SUPPLY_STATUS_CHARGING;
 			}
@@ -652,6 +664,10 @@ static int acpi_battery_get_state(struct acpi_battery *battery)
 	int result = 0;
 	acpi_status status = 0;
 	struct acpi_buffer buffer = { ACPI_ALLOCATE_BUFFER, NULL };
+	union acpi_object arg0 = { ACPI_TYPE_INTEGER };
+	struct acpi_object_list args = { 1, &arg0 };
+	arg0.integer.value = 100;
+
 
 	if (!acpi_battery_present(battery))
 		return 0;
@@ -675,6 +691,18 @@ static int acpi_battery_get_state(struct acpi_battery *battery)
 	battery->update_time = jiffies;
 	kfree(buffer.pointer);
 
+	/*
+	 * Read _BCT (Battery charge time) to determine if we are really
+	 * charging.
+	 */
+	status = acpi_evaluate_integer(battery->device->handle, "_BCT",
+				      &args, &battery->charge_time);
+
+	if (ACPI_FAILURE(status)) {
+		acpi_handle_info(battery->device->handle,
+				 "_BCT evaluation failed: %s",
+				 acpi_format_exception(status));
+	}
 	/* For buggy DSDTs that report negative 16-bit values for either
 	 * charging or discharging current and/or report 0 as 65536
 	 * due to bad math.
-- 
2.55.0

