From 80ed3b2cc16f698755a85af5f62b18014c0c9c9b Mon Sep 17 00:00:00 2001
From: Cristian Ciocaltea <cristian.ciocaltea@collabora.com>
Date: Sat, 2 Mar 2024 03:48:51 +0200
Subject: [PATCH] gitlab-ci: Set global defaults

Provide defaults for interruptible and tags.

Signed-off-by: Cristian Ciocaltea <cristian.ciocaltea@collabora.com>
Signed-off-by: Henry Paradiz <henry.paradiz@gmail.com>
---
 .gitlab-ci.yml | 9 +++++++--
 1 file changed, 7 insertions(+), 2 deletions(-)

diff --git a/.gitlab-ci.yml b/.gitlab-ci.yml
index 184b4cbb4956..d2114ee26e41 100644
--- a/.gitlab-ci.yml
+++ b/.gitlab-ci.yml
@@ -6,10 +6,17 @@ variables:
   GIT_AUTHOR_NAME: "Gitlab-ci"
   GIT_AUTHOR_EMAIL: "gitlab@gitlab.steamos.cloud"
 
+default:
+  interruptible: true
+  tags:
+    - autoscaled
+
 workflow:
   rules:
     - if: $CI_COMMIT_TAG
     - if: $CI_COMMIT_BRANCH
+  auto_cancel:
+    on_new_commit: interruptible
 
 stages:
   - check-image
@@ -67,8 +74,6 @@ stages:
     IMAGE_DISTRO_TAG: buster-slim
     IMAGE_NAME: debian-kernel-builder
     IMAGE_TAG: "2024-02-29"
-  tags:
-    - autoscaled
 
 check-debian-kernel-builder:
   extends:
-- 
2.55.0

