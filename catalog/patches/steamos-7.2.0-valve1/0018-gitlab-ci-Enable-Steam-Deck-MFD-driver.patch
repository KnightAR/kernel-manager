From ae796b9fe019ddb96859aa0db400c3fa2f5aa39c Mon Sep 17 00:00:00 2001
From: Cristian Ciocaltea <cristian.ciocaltea@collabora.com>
Date: Mon, 7 Nov 2022 20:13:44 +0200
Subject: [PATCH] gitlab-ci: Enable Steam Deck MFD driver

This deprecates the Jupiter ACPI platform driver (CONFIG_JUPITER).

Signed-off-by: Cristian Ciocaltea <cristian.ciocaltea@collabora.com>
Signed-off-by: Henry Paradiz <henry.paradiz@gmail.com>
---
 .config-fragment | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/.config-fragment b/.config-fragment
index 6d54850f057e..74548b73a973 100644
--- a/.config-fragment
+++ b/.config-fragment
@@ -2,7 +2,10 @@ CONFIG_SPI=y
 CONFIG_SPI_AMD=y
 CONFIG_PINCTRL_AMD=y
 
-CONFIG_JUPITER=y
+CONFIG_MFD_STEAMDECK=y
+CONFIG_EXTCON_STEAMDECK=y
+CONFIG_LEDS_STEAMDECK=y
+CONFIG_SENSORS_STEAMDECK=y
 
 CONFIG_SND_SOC=y
 CONFIG_SND_SOC_AMD_ACP5x=y
-- 
2.55.0

