From 598d9aee59a84a01fff12dd363c6d1f09e928640 Mon Sep 17 00:00:00 2001
From: Matthew Schwartz <matthew.schwartz@linux.dev>
Date: Mon, 22 Jun 2026 11:43:26 -0700
Subject: [PATCH] [FOR-UPSTREAM] mmc: rtsx: add MSI Claw A8 to quirk table for
 NO_AGGRESSIVE_PM

Signed-off-by: Matthew Schwartz <matthew.schwartz@linux.dev>
Signed-off-by: Henry Paradiz <henry.paradiz@gmail.com>
---
 drivers/mmc/host/rtsx_pci_sdmmc.c | 8 ++++++++
 1 file changed, 8 insertions(+)

diff --git a/drivers/mmc/host/rtsx_pci_sdmmc.c b/drivers/mmc/host/rtsx_pci_sdmmc.c
index bbe509de5941..e785594e7fc4 100644
--- a/drivers/mmc/host/rtsx_pci_sdmmc.c
+++ b/drivers/mmc/host/rtsx_pci_sdmmc.c
@@ -120,6 +120,14 @@ static const struct dmi_system_id rtsx_pci_sdmmc_dmi_quirks[] = {
 			DMI_MATCH(DMI_BOARD_NAME, "MS-1T52"),
 		},
 	},
+	{
+		/* MSI Claw A8 BZ2EM */
+		.driver_data = (void *)QUIRK_NO_AGGRESSIVE_PM,
+		.matches = {
+			DMI_MATCH(DMI_BOARD_VENDOR, "Micro-Star International Co., Ltd."),
+			DMI_MATCH(DMI_BOARD_NAME, "MS-1T8K"),
+		},
+	},
 	{},
 };
 
-- 
2.55.0

