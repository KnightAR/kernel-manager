From 2c3d577974165e76dcb72ebcacc500966023fbb4 Mon Sep 17 00:00:00 2001
From: Natalie Vock <nat@pixelcluster.dev>
Date: Wed, 12 Aug 2026 16:07:02 +0200
Subject: [PATCH] [FOR-UPSTREAM] drm/amdgpu: Include CS VM handling in drm-exec
 retry loop
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

VM handling allocates page table BOs which also need to have a drm_exec
object associated to not randomly fail under contention.

Signed-off-by: Natalie Vock <nat@pixelcluster.dev>
[nfraprado: fixed conflicts]
Signed-off-by: Nícolas F. R. A. Prado <nfraprado@collabora.com>
Signed-off-by: Henry Paradiz <henry.paradiz@gmail.com>
---
 drivers/gpu/drm/amd/amdgpu/amdgpu_cs.c      | 195 +++++++++++---------
 drivers/gpu/drm/amd/amdgpu/amdgpu_dma_buf.c |   6 +-
 drivers/gpu/drm/amd/amdgpu/amdgpu_gem.c     |   3 +-
 drivers/gpu/drm/amd/amdgpu/amdgpu_vm.c      |  14 +-
 drivers/gpu/drm/amd/amdgpu/amdgpu_vm.h      |   2 +-
 5 files changed, 117 insertions(+), 103 deletions(-)

diff --git a/drivers/gpu/drm/amd/amdgpu/amdgpu_cs.c b/drivers/gpu/drm/amd/amdgpu/amdgpu_cs.c
index 8446bec04782..547b25097c09 100644
--- a/drivers/gpu/drm/amd/amdgpu/amdgpu_cs.c
+++ b/drivers/gpu/drm/amd/amdgpu/amdgpu_cs.c
@@ -895,17 +895,10 @@ retry:
 	return r;
 }
 
-static int amdgpu_cs_parser_bos(struct amdgpu_cs_parser *p,
-				union drm_amdgpu_cs *cs)
+static int amdgpu_cs_parser_init_bo_list(struct amdgpu_cs_parser *p,
+					 union drm_amdgpu_cs *cs)
 {
 	struct amdgpu_fpriv *fpriv = p->filp->driver_priv;
-	struct ttm_operation_ctx ctx = { .interruptible = true,
-					 .exec = &p->exec };
-	struct amdgpu_vm *vm = &fpriv->vm;
-	struct amdgpu_bo_list_entry *e;
-	struct drm_gem_object *obj;
-	u64 us_since_eviction_throttle;
-	unsigned int i;
 	int r;
 
 	/* p->bo_list could already be assigned if AMDGPU_CHUNK_ID_BO_HANDLES is present */
@@ -924,8 +917,21 @@ static int amdgpu_cs_parser_bos(struct amdgpu_cs_parser *p,
 		if (r)
 			return r;
 	}
+	return 0;
+}
 
-	mutex_lock(&p->bo_list->bo_list_mutex);
+static int amdgpu_cs_parser_bos(struct amdgpu_cs_parser *p,
+				union drm_amdgpu_cs *cs)
+{
+	struct amdgpu_fpriv *fpriv = p->filp->driver_priv;
+	struct ttm_operation_ctx ctx = { .interruptible = true,
+					 .exec = &p->exec };
+	struct amdgpu_vm *vm = &fpriv->vm;
+	struct amdgpu_bo_list_entry *e;
+	struct drm_gem_object *obj;
+	u64 us_since_eviction_throttle;
+	unsigned int i;
+	int r;
 
 	/* Get userptr backing pages. If pages are updated after registered
 	 * in amdgpu_gem_userptr_ioctl(), amdgpu_cs_list_validate() will do
@@ -955,86 +961,79 @@ static int amdgpu_cs_parser_bos(struct amdgpu_cs_parser *p,
 		e->user_invalidated = userpage_invalidated;
 	}
 
-	drm_exec_until_all_locked(&p->exec) {
-		r = amdgpu_vm_lock_pd(&fpriv->vm, &p->exec, 1 + p->gang_size);
-		drm_exec_retry_on_contention(&p->exec);
+	r = amdgpu_vm_lock_pd(&fpriv->vm, &p->exec, 1 + p->gang_size);
+	if (unlikely(r))
+		goto out_free_user_pages;
+
+	us_since_eviction_throttle =
+		ktime_to_us(ktime_get()) -
+		READ_ONCE(fpriv->vm.last_evict_throttle_start_us);
+	p->vm_eviction_throttle_soft = us_since_eviction_throttle <=
+				       VM_EVICT_THROTTLE_SOFT_TIMEOUT;
+	p->vm_eviction_throttle_hard = us_since_eviction_throttle <=
+				       VM_EVICT_THROTTLE_HARD_TIMEOUT;
+
+	amdgpu_bo_list_for_each_entry(e, p->bo_list) {
+		r = drm_exec_prepare_obj(&p->exec, &e->bo->tbo.base,
+					 TTM_NUM_MOVE_FENCES + p->gang_size);
 		if (unlikely(r))
 			goto out_free_user_pages;
 
-		us_since_eviction_throttle =
-			ktime_to_us(ktime_get()) -
-			READ_ONCE(fpriv->vm.last_evict_throttle_start_us);
-		p->vm_eviction_throttle_soft = us_since_eviction_throttle <=
-					       VM_EVICT_THROTTLE_SOFT_TIMEOUT;
-		p->vm_eviction_throttle_hard = us_since_eviction_throttle <=
-					       VM_EVICT_THROTTLE_HARD_TIMEOUT;
-
-		amdgpu_bo_list_for_each_entry(e, p->bo_list) {
-			r = drm_exec_prepare_obj(&p->exec, &e->bo->tbo.base,
-						 TTM_NUM_MOVE_FENCES + p->gang_size);
-			drm_exec_retry_on_contention(&p->exec);
-			if (unlikely(r))
-				goto out_free_user_pages;
+		e->bo_va = amdgpu_vm_bo_find(vm, e->bo);
+	}
 
-			e->bo_va = amdgpu_vm_bo_find(vm, e->bo);
-		}
+	if (p->uf_bo) {
+		r = drm_exec_prepare_obj(&p->exec, &p->uf_bo->tbo.base,
+					 TTM_NUM_MOVE_FENCES + p->gang_size);
+		if (unlikely(r))
+			goto out_free_user_pages;
+	}
 
-		if (p->uf_bo) {
-			r = drm_exec_prepare_obj(&p->exec, &p->uf_bo->tbo.base,
-						 TTM_NUM_MOVE_FENCES + p->gang_size);
-			drm_exec_retry_on_contention(&p->exec);
-			if (unlikely(r))
-				goto out_free_user_pages;
-		}
+	amdgpu_bo_list_for_each_userptr_entry(e, p->bo_list) {
+		struct mm_struct *usermm;
 
-		amdgpu_bo_list_for_each_userptr_entry(e, p->bo_list) {
-			struct mm_struct *usermm;
+		usermm = amdgpu_ttm_tt_get_usermm(e->bo->tbo.ttm);
+		if (usermm && usermm != current->mm) {
+			r = -EPERM;
+			goto out_free_user_pages;
+		}
 
-			usermm = amdgpu_ttm_tt_get_usermm(e->bo->tbo.ttm);
-			if (usermm && usermm != current->mm) {
-				r = -EPERM;
+		if (amdgpu_ttm_tt_is_userptr(e->bo->tbo.ttm) &&
+		    e->user_invalidated) {
+			amdgpu_bo_placement_from_domain(e->bo,
+							AMDGPU_GEM_DOMAIN_CPU);
+			r = ttm_bo_validate(&e->bo->tbo, &e->bo->placement,
+					    &ctx);
+			if (r)
 				goto out_free_user_pages;
-			}
 
-			if (amdgpu_ttm_tt_is_userptr(e->bo->tbo.ttm) &&
-			    e->user_invalidated) {
-				amdgpu_bo_placement_from_domain(e->bo,
-								AMDGPU_GEM_DOMAIN_CPU);
-				r = ttm_bo_validate(&e->bo->tbo, &e->bo->placement,
-						    &ctx);
-				drm_exec_retry_on_contention(&p->exec);
-				if (r)
-					goto out_free_user_pages;
-
-				amdgpu_ttm_tt_set_user_pages(e->bo->tbo.ttm,
-							     e->range);
-			}
+			amdgpu_ttm_tt_set_user_pages(e->bo->tbo.ttm,
+						     e->range);
 		}
+	}
 
-		amdgpu_cs_get_threshold_for_moves(p->adev, &p->bytes_moved_threshold,
-						  &p->bytes_moved_vis_threshold);
-		p->bytes_moved = 0;
-		p->bytes_moved_vis = 0;
+	amdgpu_cs_get_threshold_for_moves(p->adev, &p->bytes_moved_threshold,
+					  &p->bytes_moved_vis_threshold);
+	p->bytes_moved = 0;
+	p->bytes_moved_vis = 0;
 
-		r = amdgpu_vm_validate(p->adev, &fpriv->vm, NULL,
-				       amdgpu_cs_bo_validate, p);
-		drm_exec_retry_on_contention(&p->exec);
-		if (r) {
+	r = amdgpu_vm_validate(p->adev, &fpriv->vm, NULL,
+			       amdgpu_cs_bo_validate, p);
+	if (r) {
+		if (r != -EDEADLK)
 			drm_err(adev_to_drm(p->adev), "amdgpu_vm_validate() failed.\n");
-			goto out_free_user_pages;
-		}
-
-		drm_exec_for_each_locked_object(&p->exec, obj) {
-			r = amdgpu_cs_bo_validate(p, gem_to_amdgpu_bo(obj));
-			drm_exec_retry_on_contention(&p->exec);
-			if (unlikely(r))
-				goto out_free_user_pages;
-		}
+		goto out_free_user_pages;
+	}
 
-		amdgpu_cs_report_moved_bytes(p->adev, p->bytes_moved,
-					     p->bytes_moved_vis);
+	drm_exec_for_each_locked_object(&p->exec, obj) {
+		r = amdgpu_cs_bo_validate(p, gem_to_amdgpu_bo(obj));
+		if (unlikely(r))
+			goto out_free_user_pages;
 	}
 
+	amdgpu_cs_report_moved_bytes(p->adev, p->bytes_moved,
+				     p->bytes_moved_vis);
+
 	if (p->uf_bo) {
 		r = amdgpu_ttm_alloc_gart(&p->uf_bo->tbo);
 		if (unlikely(r))
@@ -1054,7 +1053,6 @@ out_free_user_pages:
 		amdgpu_hmm_range_free(e->range);
 		e->range = NULL;
 	}
-	mutex_unlock(&p->bo_list->bo_list_mutex);
 	return r;
 }
 
@@ -1177,12 +1175,13 @@ static int amdgpu_cs_vm_handling(struct amdgpu_cs_parser *p)
 	if (!amdgpu_vm_ready(vm))
 		return -EINVAL;
 
-	r = amdgpu_vm_delayed_free(adev, vm);
+	amdgpu_vm_update_ctx_init(&update_ctx, adev, vm);
+	update_ctx.exec = &p->exec;
+
+	r = amdgpu_vm_delayed_free(&update_ctx);
 	if (r)
 		return r;
 
-	amdgpu_vm_update_ctx_init(&update_ctx, adev, vm);
-
 	r = amdgpu_vm_bo_update(&update_ctx, fpriv->prt_va, false);
 	if (r)
 		goto err_fini_ctx;
@@ -1515,22 +1514,36 @@ int amdgpu_cs_ioctl(struct drm_device *dev, void *data, struct drm_file *filp)
 	if (r)
 		goto error_fini;
 
-	r = amdgpu_cs_parser_bos(&parser, data);
-	if (r) {
-		if (r == -ENOMEM)
-			drm_err(dev, "Not enough memory for command submission!\n");
-		else if (r != -ERESTARTSYS && r != -EAGAIN)
-			drm_dbg(dev, "Failed to process the buffer list %d!\n", r);
+	r = amdgpu_cs_parser_init_bo_list(&parser, data);
+	if (r)
 		goto error_fini;
-	}
 
-	r = amdgpu_cs_patch_jobs(&parser);
-	if (r)
-		goto error_backoff;
+	mutex_lock(&parser.bo_list->bo_list_mutex);
 
-	r = amdgpu_cs_vm_handling(&parser);
-	if (r)
-		goto error_backoff;
+	drm_exec_until_all_locked(&parser.exec)
+	{
+		r = amdgpu_cs_parser_bos(&parser, data);
+		drm_exec_retry_on_contention(&parser.exec);
+		if (r) {
+			if (r == -ENOMEM)
+				drm_err(dev,
+					"Not enough memory for command submission!\n");
+			else if (r != -ERESTARTSYS && r != -EAGAIN)
+				drm_dbg(dev,
+					"Failed to process the buffer list %d!\n",
+					r);
+			goto error_backoff;
+		}
+
+		r = amdgpu_cs_patch_jobs(&parser);
+		if (r)
+			goto error_backoff;
+
+		r = amdgpu_cs_vm_handling(&parser);
+		drm_exec_retry_on_contention(&parser.exec);
+		if (r)
+			goto error_backoff;
+	}
 
 	r = amdgpu_cs_sync_rings(&parser);
 	if (r)
diff --git a/drivers/gpu/drm/amd/amdgpu/amdgpu_dma_buf.c b/drivers/gpu/drm/amd/amdgpu/amdgpu_dma_buf.c
index 7266e57c99f5..5704bc4e77e3 100644
--- a/drivers/gpu/drm/amd/amdgpu/amdgpu_dma_buf.c
+++ b/drivers/gpu/drm/amd/amdgpu/amdgpu_dma_buf.c
@@ -468,6 +468,7 @@ amdgpu_dma_buf_move_notify(struct dma_buf_attachment *attach)
 	struct amdgpu_bo *bo = gem_to_amdgpu_bo(obj);
 	struct amdgpu_device *adev = amdgpu_ttm_adev(bo->tbo.bdev);
 	struct ttm_operation_ctx ctx = { false, false };
+	struct amdgpu_vm_update_ctx update_ctx;
 	struct ttm_placement placement = {};
 	struct amdgpu_vm_bo_base *bo_base;
 	int r;
@@ -507,10 +508,12 @@ amdgpu_dma_buf_move_notify(struct dma_buf_attachment *attach)
 				continue;
 		}
 
+		amdgpu_vm_update_ctx_init(&update_ctx, adev, vm);
+
 		/* Reserve fences for two SDMA page table updates */
 		r = dma_resv_reserve_fences(resv, 2);
 		if (!r)
-			r = amdgpu_vm_delayed_free(adev, vm);
+			r = amdgpu_vm_delayed_free(&update_ctx);
 
 		/* Don't pass 'ticket' to amdgpu_vm_handle_moved: we want the clear=true
 		 * path to be used otherwise we might update the PT of another process
@@ -526,6 +529,7 @@ amdgpu_dma_buf_move_notify(struct dma_buf_attachment *attach)
 				  r);
 
 		dma_resv_unlock(resv);
+		amdgpu_vm_update_ctx_fini(&update_ctx);
 	}
 }
 
diff --git a/drivers/gpu/drm/amd/amdgpu/amdgpu_gem.c b/drivers/gpu/drm/amd/amdgpu/amdgpu_gem.c
index c963c8f46db8..96fa7f8ecb41 100644
--- a/drivers/gpu/drm/amd/amdgpu/amdgpu_gem.c
+++ b/drivers/gpu/drm/amd/amdgpu/amdgpu_gem.c
@@ -826,7 +826,7 @@ amdgpu_gem_va_update_vm(struct amdgpu_vm_update_ctx *ctx,
 	return fence;
 
 error:
-	if (r && r != -ERESTARTSYS)
+	if (r && r != -ERESTARTSYS && r != -EDEADLK)
 		DRM_ERROR("Couldn't update BO_VA (%d)\n", r);
 
 	return dma_fence_get(ctx->vm->last_update);
@@ -1007,6 +1007,7 @@ int amdgpu_gem_va_ioctl(struct drm_device *dev, void *data,
 
 			fence = amdgpu_gem_va_update_vm(&update_ctx, bo_va,
 							args->operation);
+			drm_exec_retry_on_contention(&exec);
 
 			if (timeline_syncobj) {
 				if (!args->vm_timeline_point) {
diff --git a/drivers/gpu/drm/amd/amdgpu/amdgpu_vm.c b/drivers/gpu/drm/amd/amdgpu/amdgpu_vm.c
index e3ed14074918..6f5b2f764ad9 100644
--- a/drivers/gpu/drm/amd/amdgpu/amdgpu_vm.c
+++ b/drivers/gpu/drm/amd/amdgpu/amdgpu_vm.c
@@ -1702,12 +1702,12 @@ int amdgpu_vm_clear_freed(struct amdgpu_vm_update_ctx *ctx,
 		r = amdgpu_vm_update_range(ctx, false, false, true, false,
 					   mapping->start, mapping->last, 0, 0,
 					   0, NULL, NULL, &f);
-		list_del(&mapping->list);
-		amdgpu_vm_free_mapping(ctx->adev, ctx->vm, mapping, f);
 		if (r) {
 			dma_fence_put(f);
 			return r;
 		}
+		list_del(&mapping->list);
+		amdgpu_vm_free_mapping(ctx->adev, ctx->vm, mapping, f);
 	}
 
 	if (fence && f) {
@@ -1734,17 +1734,13 @@ int amdgpu_vm_clear_freed(struct amdgpu_vm_update_ctx *ctx,
  * 0 for success.
  *
  */
-int amdgpu_vm_delayed_free(struct amdgpu_device *adev, struct amdgpu_vm *vm)
+int amdgpu_vm_delayed_free(struct amdgpu_vm_update_ctx *ctx)
 {
-	struct amdgpu_vm_update_ctx ctx;
 	int r;
 
-	amdgpu_vm_update_ctx_init(&ctx, adev, vm);
-
-	list_splice_init(&vm->delayed_freed, &ctx.freed);
-	r = amdgpu_vm_clear_freed(&ctx, NULL);
+	list_splice_init(&ctx->vm->delayed_freed, &ctx->freed);
+	r = amdgpu_vm_clear_freed(ctx, NULL);
 
-	amdgpu_vm_update_ctx_fini(&ctx);
 	return r;
 }
 
diff --git a/drivers/gpu/drm/amd/amdgpu/amdgpu_vm.h b/drivers/gpu/drm/amd/amdgpu/amdgpu_vm.h
index e554a86f22a5..a6d32bcffd4c 100644
--- a/drivers/gpu/drm/amd/amdgpu/amdgpu_vm.h
+++ b/drivers/gpu/drm/amd/amdgpu/amdgpu_vm.h
@@ -566,7 +566,7 @@ void amdgpu_vm_flush(struct amdgpu_ring *ring, struct amdgpu_job *job, bool need
 int amdgpu_vm_update_pdes(struct amdgpu_vm_update_ctx *ctx, bool immediate);
 int amdgpu_vm_clear_freed(struct amdgpu_vm_update_ctx *ctx,
 			  struct dma_fence **fence);
-int amdgpu_vm_delayed_free(struct amdgpu_device *adev, struct amdgpu_vm *vm);
+int amdgpu_vm_delayed_free(struct amdgpu_vm_update_ctx *ctx);
 int amdgpu_vm_handle_moved(struct amdgpu_device *adev,
 			   struct amdgpu_vm *vm,
 			   struct ww_acquire_ctx *ticket);
-- 
2.55.0

