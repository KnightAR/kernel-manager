From ef5385f2ee2ee3d895a80c88e508d9910fe097cc Mon Sep 17 00:00:00 2001
From: Natalie Vock <natalie.vock@gmx.de>
Date: Fri, 19 Jun 2026 19:04:59 +0200
Subject: [PATCH] [FOR-UPSTREAM] drm/ttm: Swap resources and bulk moves
 atomically
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Unlocking and relocking opens us up to race conditions, and concurrent
LRU traversal can potentially end up seeing very weird results.

Signed-off-by: Natalie Vock <natalie.vock@gmx.de>
[nfraprado: reworked for b2a5b7425927 drm/ttm: Add ordered bulk moves]
Signed-off-by: Nícolas F. R. A. Prado <nfraprado@collabora.com>
Signed-off-by: Henry Paradiz <henry.paradiz@gmail.com>
---
 drivers/gpu/drm/ttm/ttm_bo.c      | 4 ++--
 drivers/gpu/drm/ttm/ttm_bo_util.c | 6 ++++--
 include/drm/ttm/ttm_bo.h          | 2 ++
 3 files changed, 8 insertions(+), 4 deletions(-)

diff --git a/drivers/gpu/drm/ttm/ttm_bo.c b/drivers/gpu/drm/ttm/ttm_bo.c
index ffd44bad88f3..63ce6df8f633 100644
--- a/drivers/gpu/drm/ttm/ttm_bo.c
+++ b/drivers/gpu/drm/ttm/ttm_bo.c
@@ -86,8 +86,8 @@ void ttm_bo_move_to_lru_tail(struct ttm_buffer_object *bo)
 }
 EXPORT_SYMBOL(ttm_bo_move_to_lru_tail);
 
-static void ttm_bo_set_bulk_move_locked(struct ttm_buffer_object *bo,
-					struct ttm_lru_bulk_move *bulk)
+void ttm_bo_set_bulk_move_locked(struct ttm_buffer_object *bo,
+				 struct ttm_lru_bulk_move *bulk)
 {
 	if (bo->resource)
 		ttm_resource_del_bulk_move(bo->resource, bo);
diff --git a/drivers/gpu/drm/ttm/ttm_bo_util.c b/drivers/gpu/drm/ttm/ttm_bo_util.c
index 76b503c02ad7..6dbba4ac3e06 100644
--- a/drivers/gpu/drm/ttm/ttm_bo_util.c
+++ b/drivers/gpu/drm/ttm/ttm_bo_util.c
@@ -281,9 +281,11 @@ static int ttm_buffer_object_transfer(struct ttm_buffer_object *bo,
 	}
 
 	if (fbo->base.resource) {
-		ttm_resource_set_bo(fbo->base.resource, &fbo->base);
+		spin_lock(&bo->bdev->lru_lock);
+		fbo->base.resource->bo = &fbo->base;
 		bo->resource = NULL;
-		ttm_bo_set_bulk_move(&fbo->base, NULL);
+		ttm_bo_set_bulk_move_locked(&fbo->base, NULL);
+		spin_unlock(&bo->bdev->lru_lock);
 	} else {
 		fbo->base.bulk_move = NULL;
 	}
diff --git a/include/drm/ttm/ttm_bo.h b/include/drm/ttm/ttm_bo.h
index 03337d8c3813..229a94489469 100644
--- a/include/drm/ttm/ttm_bo.h
+++ b/include/drm/ttm/ttm_bo.h
@@ -412,6 +412,8 @@ void ttm_bo_set_bulk_move(struct ttm_buffer_object *bo,
 void ttm_bo_set_bulk_move_ordered(struct ttm_buffer_object *bo,
 				  struct ttm_lru_bulk_move *bulk,
 				  uint32_t bulk_order);
+void ttm_bo_set_bulk_move_locked(struct ttm_buffer_object *bo,
+				 struct ttm_lru_bulk_move *bulk);
 int ttm_bo_evict(struct ttm_buffer_object *bo, struct ttm_operation_ctx *ctx);
 bool ttm_bo_eviction_valuable(struct ttm_buffer_object *bo,
 			      const struct ttm_place *place);
-- 
2.55.0

